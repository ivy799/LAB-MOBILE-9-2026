<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/bg_primary"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Posts"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more_horiz"
            android:tint="@color/text_primary"/>
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/profile_main"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="pempek2rb"
                    android:textStyle="bold"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"/>

                <ImageView
                    android:id="@+id/btnMorePost"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_more_horiz"
                    android:tint="@color/text_primary"
                    android:padding="4dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgPost"
                android:layout_width="match_parent"
                android:layout_height="375dp"
                android:scaleType="centerCrop"
                android:src="@drawable/feed1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/btnLike"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_heart"
                    android:tint="@color/text_primary"
                    android:padding="2dp"
                    android:layout_marginEnd="4dp"/>

                <ImageView
                    android:id="@+id/btnComment"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_comment"
                    android:tint="@color/text_primary"
                    android:padding="2dp"
                    android:layout_marginEnd="4dp"/>

                <ImageView
                    android:id="@+id/btnShare"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_send"
                    android:tint="@color/text_primary"
                    android:padding="2dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/btnBookmark"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_bookmark"
                    android:tint="@color/text_primary"
                    android:padding="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="234 likes"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvUsernameCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pempek2rb"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="finally found this key, mks unounhas"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimeAgo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2h"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>