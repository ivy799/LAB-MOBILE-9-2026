<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Halo, Trader!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A73E8"
                android:fontFamily="sans-serif-black"/>

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@android:drawable/ic_menu_myplaces"
                android:backgroundTint="#1A73E8"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A73E8"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Nilai Portofolio"
                    android:textSize="14sp"
                    android:textColor="#D2E3FC"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 14.500.000"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Trade"
                            android:textColor="#D2E3FC"
                            android:textSize="12sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7 Transaksi"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Win Rate"
                            android:textColor="#D2E3FC"
                            android:textSize="12sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="68%"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aksi Cepat"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Top Up"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#E8F0FE"
                android:textColor="#1A73E8"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"
                android:elevation="0dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Tarik Dana"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#E8F0FE"
                android:textColor="#1A73E8"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"
                android:elevation="0dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Analisis"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#E8F0FE"
                android:textColor="#1A73E8"
                app:cornerRadius="12dp"
                android:elevation="0dp"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Finansial Jangka Panjang"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="12dp"/>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="5"
                    android:max="100"
                    android:progressTint="#1A73E8"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Terkumpul: 5%"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target: Rp 6 Miliar"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat Transaksi Terakhir"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:layout_marginBottom="32dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:padding="8dp">

                <TableRow android:padding="12dp">
                    <TextView android:text="KODE" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:text="TIPE" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:text="AVG" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:text="NOTE" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:gravity="center"/>
                </TableRow>

                <View android:layout_height="1dp" android:background="?android:attr/listDivider" android:layout_marginBottom="4dp"/>

                <TableRow android:paddingVertical="12dp" android:paddingHorizontal="12dp">
                    <TextView android:text="CHEM" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="BUY" android:textColor="#0F9D58" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:text="150" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="-" android:textColor="?android:attr/textColorSecondary" android:gravity="center" android:textSize="16sp"/>
                </TableRow>

                <TableRow android:paddingVertical="12dp" android:paddingHorizontal="12dp">
                    <TextView android:text="NZIA" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="SELL" android:textColor="#DB4437" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:text="85" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="-" android:textColor="?android:attr/textColorSecondary" android:gravity="center" android:textSize="16sp"/>
                </TableRow>

                <TableRow android:paddingVertical="12dp" android:paddingHorizontal="12dp">
                    <TextView android:text="BBRI" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="BUY" android:textColor="#0F9D58" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:text="4850" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp"/>
                    <TextView android:text="-" android:textColor="?android:attr/textColorSecondary" android:gravity="center" android:textSize="16sp"/>
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PENGATURAN &amp; TEMA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="KELUAR (LOGOUT)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="?android:attr/colorError"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>