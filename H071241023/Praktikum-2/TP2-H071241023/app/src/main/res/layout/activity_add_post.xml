<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- HEADER: X | New post | Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/close"
            android:padding="2dp"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New post"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textSize="15sp"
            android:textColor="#0095F6"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- PREVIEW AREA BESAR -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Preview Image" />

        <!-- Placeholder sebelum foto dipilih -->
        <LinearLayout
            android:id="@+id/placeholderLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/add"
                android:alpha="0.35"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih foto dari galeri di bawah"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Expand icon kiri bawah -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:src="@drawable/add"
            android:padding="7dp"
            android:background="#66000000"
            android:scaleType="centerInside" />

    </FrameLayout>

    <!-- GALLERY SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:background="@android:color/white">

        <!-- Header: Recents ∨  |  [○] Select -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recents"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- Pill Select -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:background="#22000000">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#22000000">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/add"
                        android:scaleType="centerInside"
                        android:alpha="0.6" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select"
                    android:textSize="13sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Grid galeri foto (3 kolom) dengan tombol pick transparan di atasnya -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="3"
                android:useDefaultMargins="false">

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#C8C8C8" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#D8D8D8" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#BEBEBE" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#E0E0E0" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#CACACA" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:background="#D2D2D2" android:layout_margin="1dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/add" android:alpha="0.25"/>
                </FrameLayout>

            </GridLayout>

            <!-- Tombol pick transparan menutupi seluruh grid -->
            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="" />

        </FrameLayout>

    </LinearLayout>

    <!-- BOTTOM TAB: POST | STORY | REEL | LIVE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:gravity="center_vertical">

        <!-- POST aktif: ada garis bawah via padding + warna hitam -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POST"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:background="@android:color/black"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STORY"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REEL"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIVE"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999" />

    </LinearLayout>

    <!-- Field fungsional tersembunyi (dipakai AddPostActivity.java) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tulis caption..." />

        <Button
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload" />

    </LinearLayout>

</LinearLayout>